SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Server Auth foundation (used by @supabase/server in 6C3+).
# Keep these server-only values out of VITE_ variables and browser code.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
# Browser-safe application configuration for the Phase 6C session foundation.
# These identify the public Supabase project; they do not authenticate a user.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=
OPENAI_GENERATION_MODEL=
OPENAI_REASONING_EFFORT=
# Deployed /api/vector/sync and /api/vector/delete refuse writes unless this is
# exactly "true". They run on the Supabase service role with no notion of a
# caller, so an enabled public deployment accepts anonymous writes to shared
# knowledge. Leave unset until Tracework has a permission model. The local Vite
# dev server allows writes unless this is set to "false".
TRACEWORK_ALLOW_SHARED_WRITES=
# Phase 6D4A. When exactly "true", /api/library/collections and
# /api/library/documents additionally compose in the calling user's private and
# active-workspace rows, read under that user's own JWT so row level security
# applies. Public collections are unaffected and continue to come from the
# service-role path.
#
# THIS FLAG DOES NOT UNDO THE GRANTS. Once the 6D4A migration is applied,
# `authenticated` can read tracework_collections, tracework_library_documents,
# and four columns of workspace_members directly through the Supabase Data API
# whatever this value is, constrained by RLS but not by this variable. Turning it
# off disables Tracework's route composition only; closing the Data API surface
# requires revoking the grants.
TRACEWORK_AUTHENTICATED_LIBRARY_READS=
