{
  "name": "tracework-knowledge-brain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "check": "tsc --noEmit -p tsconfig.app.json",
    "validate:phase6b-migration": "node --experimental-strip-types scripts/validate-phase6b-migration.mjs",
    "validate:phase6b-catalog-preflight": "node --experimental-strip-types scripts/validate-phase6b-catalog-preflight.mjs",
    "inventory:phase6b": "node --experimental-strip-types scripts/phase6b-inventory.mjs --plan",
    "test:phase6c2": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --allowImportingTsExtensions --strict --skipLibCheck scripts/phase6c2-server-spike.ts && node --experimental-strip-types scripts/test-phase6c2.mjs",
    "test:phase6c3": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --allowImportingTsExtensions --strict --skipLibCheck server/auth.ts && node --experimental-strip-types scripts/test-phase6c3.mjs",
    "test:phase6c4a": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --allowImportingTsExtensions --strict --skipLibCheck server/auth.ts server/routeAuth.ts && node --experimental-strip-types scripts/test-phase6c4a.mjs",
    "test:phase6c5a": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --allowImportingTsExtensions --jsx react-jsx --strict --skipLibCheck src/auth/session.ts src/auth/AuthProvider.tsx src/auth/AuthPanel.tsx && node --experimental-strip-types scripts/test-phase6c5a.mjs",
    "seed:library": "node --experimental-strip-types scripts/seed-library.mjs",
    "test:grounded": "node --experimental-strip-types scripts/test-grounded.mjs",
    "stress:grounded": "node --experimental-strip-types scripts/stress-grounded.mjs",
    "test:retrieval": "node --experimental-strip-types scripts/test-retrieval.mjs",
    "test:reranker": "node --experimental-strip-types scripts/test-reranker.mjs",
    "test:adjudication": "node --experimental-strip-types scripts/test-adjudication.mjs",
    "test:temporal": "node --experimental-strip-types scripts/test-temporal.mjs",
    "test:temporal-normalization": "node --experimental-strip-types scripts/test-temporal-normalization.mjs",
    "test:temporal-resolution": "node --experimental-strip-types scripts/test-temporal-resolution.mjs",
    "test:temporal-coverage": "node --experimental-strip-types scripts/test-temporal-coverage.mjs",
    "test:meridian": "node --experimental-strip-types scripts/test-meridian.mjs",
    "test:phase5e-fixtures": "node --experimental-strip-types scripts/test-phase5e-fixtures.mjs",
    "test:phase5e-scope": "node --experimental-strip-types scripts/test-phase5e-scope.mjs",
    "test:phase5e-discovery": "node --experimental-strip-types scripts/test-phase5e-discovery.mjs",
    "test:phase5e-retrieval": "node --experimental-strip-types scripts/test-phase5e-retrieval.mjs",
    "test:phase5e-reasoning": "node --experimental-strip-types scripts/test-phase5e-reasoning.mjs",
    "test:phase5e-coverage": "node --experimental-strip-types scripts/test-phase5e-coverage.mjs",
    "test:phase5e-runtime-coverage": "node --experimental-strip-types scripts/test-phase5e-runtime-coverage.mjs",
    "test:phase5e-nimbus": "node --experimental-strip-types scripts/test-phase5e-nimbus.mjs",
    "test:phase5e-pipeline": "node --experimental-strip-types scripts/test-phase5e-pipeline.mjs",
    "test:phase5e-generation": "node --experimental-strip-types scripts/test-phase5e-generation.mjs",
    "test:phase5e-transport": "node --experimental-strip-types scripts/test-phase5e-transport.mjs",
    "test:phase5e-generation-route": "node --experimental-strip-types scripts/test-phase5e-generation-route.mjs",
    "test:phase5e-render": "node --experimental-strip-types scripts/test-phase5e-render.mjs",
    "test:phase5e-state-boundary": "node --experimental-strip-types scripts/test-phase5e-state-boundary.mjs",
    "eval:retrieval": "node --experimental-strip-types scripts/eval-retrieval.mjs",
    "eval:reranker": "node --experimental-strip-types scripts/eval-reranker.mjs",
    "eval:phase5c": "node --experimental-strip-types scripts/eval-phase5c.mjs",
    "eval:phase5d": "node --experimental-strip-types scripts/eval-phase5d.mjs",
    "live:phase5d": "node --experimental-strip-types scripts/live-phase5d.mjs",
    "report:phase5d-live": "node --experimental-strip-types scripts/live-phase5d.mjs --reclassify",
    "eval:conflict-corpus": "node --experimental-strip-types scripts/eval-conflict-corpus.mjs",
    "preview": "vite preview --configLoader runner"
  },
  "dependencies": {
    "@supabase/server": "1.4.1",
    "@supabase/supabase-js": "2.112.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
